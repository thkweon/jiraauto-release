      "title": "jira \uc0c1\uc138 \uc774\uc288 \uae30\ub2a5 \ud655\uc7a5 \ubc0f \ub9b4\ub9ac\uc988 \ub178\ud2b8 \ud655\uc778 \uae30\ub2a5 \ucd94\uac00",
      "notes": "jira \uc0c1\uc138 \uc774\uc288 \uae30\ub2a5 \ud655\uc7a5\n- \uc0ac\uc9c4 \ubc0f \ucca8\ubd80\ud30c\uc77c \ud655\uc778 \ubc0f \ub2e4\uc6b4\ub85c\ub4dc \uae30\ub2a5 \ucd94\uac00\n\ub9b4\ub9ac\uc988 \ub178\ud2b8 \ud655\uc778 \uae30\ub2a5\n- \ubc84\uc804 \uc5c5\uadf8\ub808\uc774\ub4dc \uc2dc \ubcc0\uacbd\ub41c \uae30\ub2a5\uc5d0 \ub300\ud55c \uc124\uba85 \ud655\uc778 \ud31d\uc5c5 \ucd94\uac00"
    }
